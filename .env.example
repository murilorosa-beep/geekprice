# PostgreSQL local (Docker Compose)
DATABASE_URL=postgresql://geekprice:geekprice@localhost:5432/geekprice

# Supabase: copie a URI de Connect, com senha codificada e sslmode=verify-full.
# DATABASE_URL pode usar Transaction pooler; migrations/backup exigem sessao.
# Se vazio, DATABASE_MIGRATION_URL usa DATABASE_URL.
DATABASE_MIGRATION_URL=
DATABASE_SSL_CA_PATH=
DATABASE_POOL_MAX=3
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
# A conexao Drizzle usa a senha PostgreSQL; SUPABASE_SECRET_KEY nao e necessaria.

# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Cadastro público e mensagens transacionais (Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cobrança recorrente (Mercado Pago).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
BILLING_ADMIN_EMAILS=
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_PRODUCT_LIMIT=500
BILLING_TRIAL_MEMBER_LIMIT=3

# Obrigatório para o endpoint POST /api/autopilot/cron (mínimo de 32 caracteres).
CRON_SECRET=

# Só habilite após revisão jurídica dos documentos e preenchimento das versões aprovadas.
LEGAL_DOCUMENTS_APPROVED=false
TERMS_VERSION=draft
PRIVACY_VERSION=draft

# Opcional. Necessária somente ao habilitar conexões ERP/e-commerce (32 bytes em Base64).
INTEGRATION_ENCRYPTION_KEY=

# Opcional. Revise termos comerciais/branding antes de ativar o Google Books.
GOOGLE_BOOKS_API_KEY=

# Catálogo/preços multijogo contratado em https://scrydex.com/pricing
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=

# Usados somente por `npm run db:seed`. Não utilize esta senha em produção.
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password

# Deixe 0 sem proxy. Valores maiores exigem proxy que remova X-Forwarded-For
# enviado pelo cliente e acesso direto ao Next.js bloqueado.
TRUSTED_PROXY_HOPS=0
